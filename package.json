{
  "name": "plantuml-to-archify",
  "version": "0.1.0",
  "description": "Transpile PlantUML and C4-PlantUML architecture diagrams to Archify JSON.",
  "type": "module",
  "license": "MIT",
  "author": "James Holland",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoggmania/plantuml-to-archify.git"
  },
  "homepage": "https://hoggmania.github.io/plantuml-to-archify/",
  "bugs": "https://github.com/hoggmania/plantuml-to-archify/issues",
  "bin": {
    "puml2archify": "./bin/puml2archify.mjs"
  },
  "exports": {
    ".": "./src/plantuml.mjs"
  },
  "files": [
    "bin/",
    "schemas/",
    "src/",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/plantuml.mjs && node --check src/validate.mjs && node --check bin/puml2archify.mjs",
    "example": "node bin/puml2archify.mjs examples/c4-container.puml examples/c4-container.architecture.json --quality standard"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
